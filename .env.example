# 이 파일을 복사하여 .env 파일을 만들고 실제 API 키를 입력하세요.
# .env 파일은 .gitignore에 등록되어 있으므로 Git에 커밋되지 않습니다.

# 1. 기본 OpenAI 호환 프록시 (Codyssey 등)
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://copa.codyssey.kr/v1
AI_MODEL=gpt-5-mini

# 2. Google Gemini 공식 OpenAI 호환 엔드포인트 사용 시 (선택 사항)
# AI_API_KEY=AIzaSy...
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-flash-latest
